# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# ----------------------------------------------------------------------
# MODE
# DEMO_MODE=true runs the entire pipeline with zero API keys using local
# deterministic providers. Set to false to use OpenAI + Cohere.
# ----------------------------------------------------------------------
DEMO_MODE=true

# ----------------------------------------------------------------------
# PROVIDERS (only read when DEMO_MODE=false)
# ----------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_GENERATION_MODEL=gpt-4o
OPENAI_QUERY_REWRITE_MODEL=gpt-4o-mini

COHERE_API_KEY=...
COHERE_RERANK_MODEL=rerank-english-v3.0

# ----------------------------------------------------------------------
# VECTOR STORE (embedded persistent Chroma — no server required)
# ----------------------------------------------------------------------
CHROMA_PERSIST_DIR=storage/chroma
CHROMA_COLLECTION=academiq_chunks

# ----------------------------------------------------------------------
# RETRIEVAL TUNING
# ----------------------------------------------------------------------
RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_FINAL=5
ENABLE_QUERY_REWRITE=true

# ----------------------------------------------------------------------
# CONFIDENCE GATE (DR-04 dual threshold) — calibrate via eval/calibrate_threshold.py
# Signal = reranker relevance of the top chunk.
# ----------------------------------------------------------------------
CONFIDENCE_HARD_REJECT=0.30
CONFIDENCE_SOFT_WARN=0.50

# ----------------------------------------------------------------------
# INGESTION
# ----------------------------------------------------------------------
MAX_SECTION_TOKENS=800
SCAN_TEXT_DENSITY_CHARS=50
ENABLE_OCR=true
PDF_DIR=data/pdfs
COLLEGE_NAME=Example Institute of Technology

# ----------------------------------------------------------------------
# SECURITY
# Generate a strong admin key with: openssl rand -hex 32
# ----------------------------------------------------------------------
API_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
RATE_LIMIT_PER_MINUTE=30

# ----------------------------------------------------------------------
# CACHE / FEEDBACK
# ----------------------------------------------------------------------
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=512
FEEDBACK_DB_PATH=storage/feedback.db
